# Copier vers .env en local, à déclarer dans Render en production.

# ── Serveur ──────────────────────────────────────────────
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=
CLERK_SECRET_KEY=

# ── Paiements, e-mails, OCR ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEMO_PAYMENTS=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
MINDEE_API_KEY=
MINDEE_MODEL_ID=

# ── Assistant IA ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Communication ────────────────────────────────────────
# Chiffre les jetons des réseaux sociaux. En changer impose de reconnecter les comptes.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_TOKEN_SECRET=
UNSPLASH_ACCESS_KEY=

# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/social/linkedin/callback
LINKEDIN_API_VERSION=

# App Meta, produit "Instagram API with Instagram Login" : utiliser l'ID de l'app Instagram, pas celui de l'app Meta
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/social/instagram/callback
INSTAGRAM_API_VERSION=
